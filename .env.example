# Sanity project (public values, safe to commit)
NEXT_PUBLIC_SANITY_PROJECT_ID=7sqg0qba
NEXT_PUBLIC_SANITY_DATASET=production

# Final domain, used for SEO, sitemap and share previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the Sanity webhook that refreshes the site on Publish.
# Any long random string; put the same value in the Sanity webhook settings.
SANITY_REVALIDATE_SECRET=

# Only needed once, to run `npm run seed` (Editor token from sanity.io/manage → API → Tokens).
# Never commit the real value.
SANITY_API_WRITE_TOKEN=
